<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="../css/XemChiTietUser.css" />
    <title>Xem chi tiết người dùng</title>
</head>
<body>
    <aside>
        <div class="sidebar">
            <div class="sidebar_title">
                <div style="margin-right: 10px;">
                    <img src="../images/coins_1.jpg" alt="User Avatar">
                </div>
                <div>
                    <h2>NGÂN SÁCH<br>NHANH CHÓNG</h2>
                </div>
            </div>
            <ul>
                <li class="home"><a href="/TrangChu" ><i class="fas fa-home"></i> Trang chủ</a></li>
                <li class="manage-user"><a href="/QuanLyNguoiDung" ><i class="fas fa-users"></i> Quản lý người dùng</a></li>
                <li class="manage-category">
                    <a href="/HangMucThuNhap" class="main-menu" style="color: #3D378B;"><i class="fa-solid fa-bars"></i> Quản lý hạng mục</a>
                    <!-- Submenu -->
                    <div class="submenu">
                        <a href="/HangMucThuNhap">Hạng mục thu nhập</a>
                        <a href="/HangMucChiPhi">Hạng mục chi phí</a>
                    </div>
                </li>            
            </ul>
        </div>
    </aside>

    <header>
        <div class="user-icon">
            <img src="../images/user_women.png" alt="User">
        </div>
        <div class="name-admin">
            <span>Administrator</span>
        </div>
        <div class="header-icon">
            <img src="../images/arrow_down.png" alt="icon">
        </div>
    </header>

    <div class="main-container">
        <div class="form-container">
          <label><span>👤</span> Tên người dùng</label>
          <div class="text-box"><%= name %></div>
      
          <label><span>📅</span> Ngày sinh</label>
          <div class="text-box"><%= birthDate %></div>
      
          <label><span>📞</span> Số điện thoại</label>
          <div class="text-box"><%= phone %></div>
      
          <label><span>✉️</span> Email</label>
          <div class="text-box"><%= email %></div>
      
          <button class="submit-button" onclick="window.location.href='/QuanLyNguoiDung'">Quay lại</button>
        </div>
        <div class="avatar-container">
          <img src="<%= avatar %>" alt="Avatar">
          <label>Ảnh đại diện</label>
        </div>
      </div>      
</body>
</html>