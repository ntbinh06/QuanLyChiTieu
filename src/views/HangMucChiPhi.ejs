<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    />
    <!-- Firebase SDK -->
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js"></script>

    <link rel="stylesheet" href="../css/HangMucChiPhi.css" />
    <title>Quản Lý Hạng Mục</title>
</head>
<body>
    <aside>
        <div class="sidebar">
            <div class="sidebar_title">
                <div style="margin-right: 10px;">
                    <img src="../images/coins_1.jpg" alt="User Avatar">
                </div>
                <div>
                    <h2>NGÂN SÁCH<br>NHANH CHÓNG</h2>
                </div>
            </div>
            <ul>
                <li class="home">
                    <a href="/TrangChu"><i class="fas fa-home"></i> Trang chủ</a>
                </li>
                <li class="manage-user">
                    <a href="/QuanLyNguoiDung"><i class="fas fa-users"></i> Quản lý người dùng</a>
                
                </li>
                <li class="manage-category">
                    <a href="/HangMucThuNhap" class="main-menu" style="color: #fff;"><i class="fa-solid fa-bars"></i> Quản lý hạng mục</a>
                    <!-- Submenu -->
                    <div class="submenu">
                        <a href="/HangMucThuNhap">Hạng mục thu nhập</a>
                        <a href="/HangMucChiPhi"><i class="fa-regular fa-circle" style="font-size: 14px;"></i>Hạng mục chi phí</a>
                    </div>
                </li>
            </ul>
            
        </div>
    </aside>

    <header>
        <div class="user-icon">
            <img src="../images/user_women.png" alt="User">
        </div>
        <div class="admin-dropdown">
            <span class="admin-name">Administrator</span>
        </div>
        <div class="header-icon">
            <img src="../images/arrow_down.png" alt="icon">
        </div>
    </header>

    <!-- Content -->
    <div class="content">
        <!-- Tìm kiếm Hạng mục -->
        <div class="search-section">
            <input type="text" placeholder="Tìm kiếm" class="search-input" id="search-input">
            <button class="search-button" id="search-button">
                <img src="../images/search_ic.png" alt="Search">
            </button>
        </div>


         <!-- Nút mở modal -->
         <button class="open-button" onclick="openModal()">
            <i class="fa-solid fa-plus" style="margin-right: 10px;"></i>
            Thêm hạng mục
        </button>

        <!-- Modal -->
        <div class="modal" id="inputModal">
            <div class="modal-content">
                <h3>Thêm hạng mục thu nhập</h3>
                <!-- Form nhập dữ liệu -->
                <input type="text" id="categoryInput" placeholder="Nhập tên hạng mục" />
                <br><br>
        
                <!-- Hiển thị ảnh đã chọn -->
                <div>
                    <h3>Ảnh đã chọn:</h3>
                    <img id="selectedImagePreview" src="" alt="Ảnh đã chọn" style="width: 100px; height: 100px; display: none;"/>
                </div>
        
                <br>
                <!-- Thêm danh sách icon -->
                <div class="icon-grid">
                    <img src="../images/salary.png" class="icon" onclick="selectIcon('salary')" alt="icon1">
                    <img src="../images/profit_margin.png" class="icon" onclick="selectIcon('profit_margin')" alt="icon2">
                    <img src="../images/funds.png" class="icon" onclick="selectIcon('funds')" alt="icon3">
                    <img src="../images/cooperation.png" class="icon" onclick="selectIcon('cooperation')" alt="icon3">
                    <img src="../images/cinema.png" class="icon" onclick="selectIcon('cinema')" alt="icon3">
                    <img src="../images/cleaning.png" class="icon" onclick="selectIcon('cleaning')" alt="icon3">
                    <img src="../images/degree.png" class="icon" onclick="selectIcon('degree')" alt="icon3">
                    <img src="../images/donate.png" class="icon" onclick="selectIcon('donate')" alt="icon3">
                    <img src="../images/education.png" class="icon" onclick="selectIcon('education')" alt="icon3">
                    <img src="../images/examination.png" class="icon" onclick="selectIcon('examination')" alt="icon3">
                    <img src="../images/health_insurance.png" class="icon" onclick="selectIcon('health_insurance')" alt="icon3">
                    <img src="../images/key.png" class="icon" onclick="selectIcon('key')" alt="icon3">
                    <img src="../images/living_room.png" class="icon" onclick="selectIcon('living_room')" alt="icon3">
                    <img src="../images/old_person.png" class="icon" onclick="selectIcon('old_person')" alt="icon3">
                    <img src="../images/small_appliance.png" class="icon" onclick="selectIcon('small_appliance')" alt="icon3">
                    <img src="../images/bill.png" class="icon" onclick="selectIcon('bill')" alt="icon3">
                    <img src="../images/personal_belongings.png" class="icon" onclick="selectIcon('personal_belongings')" alt="icon3">
                    <img src="../images/debt.png" class="icon" onclick="selectIcon('debt')" alt="icon3">
                    <img src="../images/maintenance.png" class="icon" onclick="selectIcon('maintenance')" alt="icon3">
                    <img src="../images/products.png" class="icon" onclick="selectIcon('products')" alt="icon3">
                    <!-- Thêm các icon khác tương tự -->
                </div>
        
                <br>
                <button class="submit-button" onclick="submitCategory()">Thêm</button>
                <button class="close-button" onclick="closeModal()">Hủy</button>
            </div>
        </div>

    
        <ul class="category-list">
            <% if (categoryList && categoryList.length > 0) { %>
                <% categoryList.forEach(function(category) { %>
                    <li class="category-item">
                        <div class="category-info">
                            <img src="../images/<%= category.anhHangMuc %>.png" alt="<%= category.tenHangMuc %>" class="category-image">
                            <p><%= category.tenHangMuc %></p>
                        </div>
                        <div class="category-icon">
                            <a href="#" class="category-icon-edit"><i class="fa-solid fa-pen-to-square" style="color: #000000;"></i></a>
                            <a href="#" class="category-icon-delete"><i class="fa-solid fa-trash-can" style="color: #000000;"></i></i></a>
                        </div>
                    </li>
                <% }); %>
            <% } else { %>
                <li>Không có hạng mục nào.</li>
            <% } %>
        </ul>
    </div>

    <!-- JavaScript -->
    <script src="../js/themChiPhi.js"></script>
</body>
</html>
